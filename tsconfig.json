{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "os/**/*.js",
    "terminal/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "terminal/core/process-worker.js",
    "terminal/test/**"
  ]
}
