{
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "sync:manifest": "node scripts/sync-portfolio-metadata.mjs",
    "lint": "eslint app.js mime-handlers.js generate-previews.js share.js google-db todo",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check app.js mime-handlers.js generate-previews.js share.js google-db todo",
    "format:fix": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "build:doom": "bash doom/build/build.sh"
  },
  "Private": true,
  "dependencies": {
    "jsdom": "^23.0.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.6.0",
    "eslint": "^8.20.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "http-server": "^14.1.1",
    "prettier": "^2.8.8",
    "typescript": "^6.0.2"
  }
}
