+// Browser-first defaults: the doom/src/index.js UI advertises WASD for
+// movement/strafe, Q for fire, and E for use, and dispatches synthetic
+// KeyboardEvent objects with those keys in response to mouse/touch input.
+// Without these overrides the vanilla KEY_UPARROW / KEY_RCTRL / ' ' defaults
+// leave 'w'/'q'/'e' unbound, so the gun never fires and you can't walk.
+int key_up = 'w';
+int key_down = 's';
+int key_strafeleft = 'a';
+int key_straferight = 'd';
+int key_fire = 'q';
+int key_use = 'e';
 int key_strafe = KEY_RALT;
