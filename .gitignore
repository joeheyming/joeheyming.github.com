# Local dev TLS cert (auto-regenerated by scripts/dev-server.py via mkcert /
# openssl on first run). The previous keypair was committed by accident; new
# ones must stay out of the repo. Delete the directory locally to force a
# fresh cert.
/scripts/.dev-cert/

*.DS_Store
*/Thumbs.db

# Source clone for uzdoom-wasm (if we ever need to rebuild locally).
/doom/uzdoom-src/

.brand-audit/
.playwright-cli/

# Local GA4 CSV exports for moneyball analysis
/ga4dl/

*.local.*
.agent-memory/

# Doom IWADs and map WADs are fetched at launch. See AGENTS.md.
*.wad

# Gameplay mods, fetched from the commit pinned in doom/flavors.js.
# Engine packages stay tracked: uzdoom.pk3, game_support.pk3,
# brightmaps.pk3, lights.pk3, game_widescreen_gfx.pk3.
/doom/LegendOfDoom-1.1.0.pk3
/doom/mariodoom.pk3
/doom/met2.pk3
/doom/Castlevania.ipk3
/doom/sonicdoom-legacy.pk3
