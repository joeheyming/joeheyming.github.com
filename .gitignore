.tern-port
*~
node_modules

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright-cli/
/.playwright/

# Overlap debug screenshots (generated by back-button-overlap.spec.js)
/tests/e2e/screenshots/*.png

# Claude / Cursor agent local config
/.claude/

# GSC indexing automation local state
/scripts/.gsc-results.md
/scripts/.gsc-profile/

# Local dev TLS cert (auto-regenerated by scripts/dev-server.py via mkcert /
# openssl on first run). The previous keypair was committed by accident; new
# ones must stay out of the repo. Delete the directory locally to force a
# fresh cert.
/scripts/.dev-cert/

*.DS_Store
*/Thumbs.db

# Source clone for uzdoom-wasm (if we ever need to rebuild locally).
/doom/uzdoom-src/

.brand-audit/
.playwright-cli/

# Local scratch notes (checkpoints, progress logs). Anything named
# *.local.md is intentionally never committed.
*.local.md

# Local Apps Script source (e.g. checkboxes/apps-script.local.gs). The
# canonical copy lives in the bound Google Apps Script project; the
# in-repo file is a working scratchpad whose tweaks shouldn't churn
# the diff.
*.local.gs
