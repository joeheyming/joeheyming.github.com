{
  "name": "Simpleton TV",
  "short_name": "Simpleton TV",
  "description": "Smart-TV style player streaming a public Simpsons archive from the Internet Archive — seasons 1-18 plus the movie, native MP4 playback.",
  "id": "/simpletons/",
  "start_url": "/simpletons/?source=twa",
  "scope": "/simpletons/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "landscape",
  "background_color": "#0f0d08",
  "theme_color": "#0f0d08",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["entertainment", "video"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
